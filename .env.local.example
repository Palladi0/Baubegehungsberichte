# Supabase (Optional - remove if not using backend)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Medien-Upload Verzeichnis (PROJ-4)
# Lokal: ./uploads/photos  |  Produktion (VPS): /var/uploads/photos
UPLOAD_DIR=./uploads/photos

# Template-Logo-Upload Verzeichnis (PROJ-12)
# Lokal: ./uploads/templates  |  Produktion (VPS): /var/uploads/templates
TEMPLATE_UPLOAD_PATH=./uploads/templates

# OpenAI Whisper (PROJ-9: Sprach-Transkription)
OPENAI_API_KEY=sk-...

# Twilio Sandbox (PROJ-8: WhatsApp-Integration)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+14155238886
TWILIO_WHATSAPP_NUMBER=+1xxxxxxxxxx
TWILIO_WEBHOOK_URL=https://your-domain.com/api/webhooks/twilio

# Twilio Produktions-Credentials (PROJ-11: WhatsApp Business API Migration)
# Erst ausfüllen, wenn der Meta Business Account genehmigt ist
TWILIO_PRODUCTION_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PRODUCTION_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PRODUCTION_PHONE_NUMBER=+1xxxxxxxxxx

# Add more environment variables as needed
# STRIPE_SECRET_KEY=sk_...
# SMTP_HOST=smtp.sendgrid.net
# SMTP_USER=your_smtp_user
# SMTP_PASS=your_smtp_password
